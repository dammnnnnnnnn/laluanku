# Copy to .env.local for local dev. On Replit, set these in Secrets instead.
# Never commit real values.

# Claude API (server routes only). AI_MODEL is shown on /about.
# Without a key, signal refresh falls back to deterministic keyword tagging.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Postgres (Replit's built-in database provides this)
DATABASE_URL=postgres://user:password@localhost:5432/laluanku
# Optional: connection pool size (default 5)
DATABASE_POOL_MAX=

# RunPod Serverless embedding endpoint (Infinity worker). See docs/runpod.md.
# Leave blank to use the keyword-overlap fallback.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT=
# Optional: must match the worker's MODEL_NAMES (default BAAI/bge-m3)
RUNPOD_EMBEDDING_MODEL=
# Optional: cosine similarity that counts a related skill as covering (default 0.8)
EMBEDDING_SIMILARITY_THRESHOLD=
# Optional: request timeout before falling back to keywords, in ms (default 20000)
RUNPOD_TIMEOUT_MS=

# Protects the admin "Refresh signals" action on /signals
ADMIN_TOKEN=
