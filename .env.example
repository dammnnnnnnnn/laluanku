# Copy to .env.local for local dev. On Replit, set these in Secrets instead.
# Never commit real values.

# Claude API (server routes only). AI_MODEL is shown on /about.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Postgres (Replit's built-in database provides this)
DATABASE_URL=postgres://user:password@localhost:5432/laluanku

# RunPod Serverless embedding endpoint (e.g. BAAI/bge-m3).
# Leave blank to use the keyword-overlap fallback.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT=

# Protects the admin "Refresh signals" action on /signals
ADMIN_TOKEN=
